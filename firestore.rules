rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Herkes yayınlanmış (status == "published") yazıları okuyabilir.
    // Sahibi (Firebase Auth UID'i eşleşen kullanıcı) taslaklar dahil hepsini
    // okuyabilir ve yazabilir — bu admin paneli için gerekli.
    //
    // ÖNEMLİ: Aşağıdaki OWNER_UID yerine kendi Firebase Auth kullanıcı UID'ini
    // yaz (Firebase Console -> Authentication -> Users -> ernklyc@gmail.com
    // satırındaki "User UID" değeri). Değiştirmeden deploy edersen hiç kimse
    // (sen dahil) yazamaz — güvenli varsayılan budur.
    match /posts/{postId} {
      allow read: if resource.data.status == "published"
        || (request.auth != null && request.auth.uid == "zYIbbfB5YpfCG6KHLJMpVlhT3B62");
      allow write: if request.auth != null && request.auth.uid == "zYIbbfB5YpfCG6KHLJMpVlhT3B62";
    }

    // Ana sayfa içeriği (Hero, Hakkımda, Yeteneklerim, Deneyim) — herkes
    // okuyabilir (site bunları public olarak gösterir), sadece sahibi
    // admin panelden düzenleyebilir.
    match /siteContent/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "zYIbbfB5YpfCG6KHLJMpVlhT3B62";
    }

    function isMovieLibraryOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == "zYIbbfB5YpfCG6KHLJMpVlhT3B62";
    }

    function validMediaType(value) {
      return value == "movie" || value == "tv";
    }

    function validLibraryItem() {
      return request.resource.data.keys().hasOnly([
          "tmdbId", "imdbId", "mediaType", "favorite", "isPublic",
          "snapshot", "addedAt", "updatedAt"
        ])
        && request.resource.data.tmdbId is int
        && request.resource.data.tmdbId > 0
        && validMediaType(request.resource.data.mediaType)
        && (request.resource.data.imdbId == null || request.resource.data.imdbId is string)
        && request.resource.data.favorite is bool
        && request.resource.data.isPublic is bool
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.keys().hasOnly([
          "title", "originalTitle", "year", "posterPath", "genres"
        ])
        && request.resource.data.snapshot.title is string
        && request.resource.data.snapshot.originalTitle is string
        && (request.resource.data.snapshot.year == null || request.resource.data.snapshot.year is int)
        && (request.resource.data.snapshot.posterPath == null || request.resource.data.snapshot.posterPath is string)
        && request.resource.data.snapshot.genres is list;
    }

    match /users/{uid}/library/{mediaId} {
      allow get, list: if isMovieLibraryOwner(uid) || resource.data.isPublic == true;
      allow create, update: if isMovieLibraryOwner(uid) && validLibraryItem();
      allow delete: if isMovieLibraryOwner(uid);
    }
  }
}
